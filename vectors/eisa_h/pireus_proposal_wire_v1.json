      "document": "{\"schema\":1,\"target\":701202,\"dimension\":16,\"precision\":64,\"order\":1,\"fma\":0,\"kind\":2,\"lane_stride\":1,\"lane_offset\":0,\"load\":0,\"layout\":0,\"unroll\":1,\"context\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"phase\":1128}"
