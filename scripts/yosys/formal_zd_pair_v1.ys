hierarchy -check -top eisa_h_sed16_zd_pair_v1
proc
memory
design -stash gold_design

design -reset
read_verilog -sv rtl/eisa_h_sed16_zd_pair_v1.sv
hierarchy -check -top eisa_h_sed16_zd_pair_v1
proc
memory
synth -top eisa_h_sed16_zd_pair_v1
