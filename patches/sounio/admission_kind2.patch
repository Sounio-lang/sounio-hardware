+// The bilinear phase i^T B j over F2^4, B given by the 16-bit phase code.
+// Bit (i*4 + j) of the code is the coefficient B[i][j].
+fn bilinear(code: i64, x: i64, y: i64) -> i64 with Mut {
+    var s: i64 = 0
+    var i: i64 = 0
+    while i < 4 {
+        if ((x >> i) & 1) == 1 {
+            var j: i64 = 0
+            while j < 4 {
+                if ((y >> j) & 1) == 1 { s = s ^ ((code >> (i * 4 + j)) & 1) }
+                j = j + 1
+            }
+        }
+        i = i + 1
+    }
+    s
+}
+// Structure coefficient of the operator the proposal names.
+// Phase code 0 returns cd_sigma unchanged, so kind=1 is unaffected.
+fn sigma_phase(code: i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
+    let base = cd_sigma(a as i32, b as i32, 4) as i64
+    if bilinear(code, a, b) == 1 { return 0 - base }
+    base
+}
